# Floorcast local / deploy sample env
# Copy to `.env.local` for Next.js (never commit real secrets):
#   cp .env.example .env.local

# Shared secret for POST /api/ingest (and floor-plan / path writes).
# Android webhook URL can include ?token=<same value>
# Leave unset locally to use the built-in demo token: dev-ingest-token
INGEST_TOKEN=

# Optional Postgres. When unset, Floorcast uses in-memory PGlite.
# Cursor publish sets DATABASE_URL automatically when cursor-app.json declares postgres.
DATABASE_URL=

# Direct (unpooled) Postgres URL for migrations, if your host separates pooler vs direct.
# Falls back to DATABASE_URL when empty.
DATABASE_URL_UNPOOLED=
